# Copy to .env for local development. Real secrets never go in .env.example.

APP_ENV=dev
LOG_LEVEL=INFO

# --- Local infrastructure (matches infra/docker-compose.dev.yml) ---
DATABASE_URL=postgresql+asyncpg://voiceai:voiceai_dev@localhost:5432/voiceai
REDIS_URL=redis://localhost:6379/0

# --- Auth — override all three in any shared/deployed environment ---
JWT_SECRET=dev-only-secret-change-me
SEED_ADMIN_EMAIL=admin@voiceai.local
SEED_ADMIN_PASSWORD=admin-dev-password

# --- LiveKit Cloud (WebRTC infrastructure) — https://cloud.livekit.io ---
# Project → Settings → Keys. URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (speech-to-text) — https://console.deepgram.com → API Keys ---
DEEPGRAM_API_KEY=

# --- Anthropic (LLM) — https://console.anthropic.com → Settings → API Keys ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (text-to-speech) — https://elevenlabs.io → profile → API Keys ---
ELEVENLABS_API_KEY=
